# Airtable credentials for uploading the data tables (upload_to_airtable.py).
# Copy to .env and fill in with your own values; .env is gitignored.
# Get a personal access token at https://airtable.com/create/tokens
# Scopes needed: data.records:read, data.records:write, schema.bases:read, schema.bases:write

AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
